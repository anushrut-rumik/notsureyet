OPENAI_API_KEY=
AGENT_EXA_API_KEY=
AGENT_INFERENCE_CONFIG=inference.toml
AGENT_STEPS_PER_RUN=12
# Each chat model request has a deadline; background task calls keep their provider timeout.
AGENT_CHAT_INFERENCE_TIMEOUT_SECONDS=45
# Explain a slow WhatsApp response before the chat turn finishes.
AGENT_WHATSAPP_PROGRESS_SECONDS=15
AGENT_PARALLEL_TASKS=2
AGENT_TOOL_MODULES=

# Arkiv is the default task authority. sqlite is an explicit offline mode; payments are disabled there.
AGENT_TASK_BACKEND=arkiv
AGENT_ARKIV_ACCESS_KEY=
# Fund each chat's active wallet with Rabdi tGLM; no separate task writer.
# Maximum cost for one task-checkpoint transaction, in tGLM wei (0.01 tGLM).
AGENT_ARKIV_MAX_FEE_WEI=10000000000000000
AGENT_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
AGENT_MAX_TRANSFER_ETH=0.01

# Existing Ira whatsmeow sidecar, using a dedicated hackathon line. Keep credentials server-side.
AGENT_WHATSAPP_SIDECAR_URL=
AGENT_WHATSAPP_SECRET=
AGENT_WHATSAPP_REDIS_URL=
AGENT_WHATSAPP_LINE=
AGENT_WHATSAPP_PHONE=
# Comma-separated exact one-to-one WhatsApp JIDs allowed to use this test agent.
AGENT_WHATSAPP_ALLOWED_CHATS=
AGENT_WHATSAPP_STREAM=ira:wa:in

# Dedicated wallet-only HTTPS endpoint for MetaMask Mobile. Keep the agent API private.
AGENT_WALLET_PUBLIC_URL=
AGENT_WALLET_PORT=8765

# CCIP 2.0: Ethereum Sepolia -> Base Sepolia, CCIP-BnM only.
# simulation runs Chainlink Local in an isolated EVM, without signatures or a public deployment.
# testnet sends real test tokens and requires the deployed sender address below.
AGENT_CCIP_MODE=testnet
# Deploy contracts/src/CCIPSender.sol using the setup in docs/CCIP.md, then set this address.
AGENT_CCIP_SENDER_ADDRESS=
AGENT_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Maximum native CCIP fee; source gas is separately reviewed. Quotes include a 10% fee buffer.
AGENT_CCIP_MAX_FEE_ETH=0.01
# Maximum gas cost for deploying the sender from connected MetaMask.
AGENT_CCIP_MAX_DEPLOYMENT_FEE_ETH=0.005
