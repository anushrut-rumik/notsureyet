pragma solidity 0.8.26;
import {TestStrategyWallet} from "../../src/lending/TestStrategyWallet.sol";

// Golden vector generated by lending/report.ts through viem.
contract EncodingVectorTest {
    function testViemReportDecodesAsSolidityTuple() public pure {
        bytes memory raw =
            hex"";
        (TestStrategyWallet.Instruction memory i, bytes memory signature) =
            abi.decode(raw, (TestStrategyWallet.Instruction, bytes));
        require(
            i.operationId == bytes32(hex"0101010101010101010101010101010101010101010101010101010101010101")
                && i.sourceChainId == 11155111 && i.consumer == address(0x2222222222222222222222222222222222222222)
        );
        require(
            i.destinationSelector == 10344971235874465080
                && i.destination == address(0x3333333333333333333333333333333333333333)
        );
        require(i.token == address(0x4444444444444444444444444444444444444444) && i.amount == 123);
        require(
            i.policyVersion == bytes32(hex"5555555555555555555555555555555555555555555555555555555555555555")
                && i.expiry == 2000 && signature.length == 65
        );
        require(keccak256(raw) == keccak256(abi.encode(i, signature)));
    }
}
